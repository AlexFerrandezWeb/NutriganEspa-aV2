# Configuración del servidor
PORT=3000

# Claves de Stripe (reemplazar con las claves reales)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
# Secreto de firma del webhook. Sale al dar de alta el endpoint en el Dashboard
# de Stripe (Desarrolladores -> Webhooks). Sin el, /api/stripe/webhook rechaza
# todo lo que le llega.
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Analytics 4 (envío de compras desde el servidor).
# El ID es el mismo que lleva la web en el <head>. El secreto se crea en GA4:
# Administrador -> Flujos de datos -> el flujo web -> Measurement Protocol.
# Si faltan, la web funciona igual pero las compras no se cuentan en Analytics.
GA4_MEASUREMENT_ID=G-2ZN5E3WV35
GA4_API_SECRET=

# Configuración de email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-password-de-aplicacion
EMAIL_FROM=tu-email@gmail.com
EMAIL_TO=pedidos@nutrigan.es
